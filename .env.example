# Provider: openai or local.
FORGE_PROVIDER=openai

# Required for OpenAI. Keep the real value private.
OPENAI_API_KEY=

# Optional: defaults to gpt-4o-mini.
FORGE_MODEL=gpt-4o-mini

# Local OpenAI-compatible endpoint settings (use with FORGE_PROVIDER=local).
# MODEL_NAME=llama3.2
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_CONTEXT_WINDOW=32768

# Bounded repair approvals per task (1-10, default 3).
FORGE_MAX_REPAIR_ATTEMPTS=3

# Optional runtime controls.
# FORGE_DEBUG=1
# FORGE_COMMAND_TIMEOUT_MS=60000
